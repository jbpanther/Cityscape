# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. This file (.env.example) is committed as documentation,
# so NEVER put real values here.

# --- Supabase -------------------------------------------------------------
# Project URL — same one the iOS app uses. Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE-ROLE key, NOT the anon key.
#
# Why: scraped events belong to no user, so `created_by` is NULL. The RLS policy
# "events insertable by owner" requires auth.uid() = created_by, which no
# anonymous client can satisfy. The service-role key bypasses RLS entirely.
#
# This makes it a REAL secret — anyone holding it has full read/write access to
# your database. Keep it out of git, out of the iOS app, and out of screenshots.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Ticketmaster ---------------------------------------------------------
# Free key from https://developer.ticketmaster.com/ (Discovery API).
# Default quota: 5,000 calls/day, 5 requests/second.
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key-here
